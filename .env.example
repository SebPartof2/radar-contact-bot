# Discord application — required for the bot.
# Channel, manager role, and monitors are set per server (/rc setup or the dashboard).
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Web dashboard — set BOTH of these to enable it; leave either blank and the bot
# runs headless with no web server at all.
# BASE_URL is the public URL, and <BASE_URL>/auth/callback must be added as a
# redirect URI under OAuth2 in the Discord developer portal.
DISCORD_CLIENT_SECRET=
BASE_URL=https://rcnotify.example.com

# Host port for local `docker compose up` only. On Dokploy the proxy handles the
# domain, and the container always listens on 3000 — point the domain there.
WEB_PORT=3000

# Optional
POLL_INTERVAL_MS=15000
MISSED_POLLS_BEFORE_OFFLINE=2
SESSION_TTL_MS=604800000
TZ=UTC
